// Internal mask, not an MSL bool-vector storage/interface type.
struct __bool_mask2 { bool lane[2]; };
AIR_INLINE __bool_mask2 isnan(float2 x) { __bool_mask2 r; for(uint i=0;i<2;++i) r.lane[i]=isnan(x[i]); return r; }
