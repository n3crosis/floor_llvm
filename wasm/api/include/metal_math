#define AIR_INLINE inline __attribute__((always_inline))
AIR_INLINE float fma(float a,float b,float c) { return __air_detail::fma(a,b,c); }
AIR_INLINE bool isnan(float x) { return (__builtin_bit_cast(uint,x) & 0x7fffffffU) > 0x7f800000U; }
