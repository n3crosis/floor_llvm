#if !defined(AIR_FAST_MATH) || AIR_FAST_MATH != 1
// Conservative maximum preserves finite operands and chooses +0 over -0.
// One NaN selects the numeric operand; two NaNs retain the second payload.
AIR_INLINE float max(float a,float b) {
  if (isnan(a)) return b;
  if (isnan(b)) return a;
  if (a==b) return as_type<float>(as_type<uint>(a) & as_type<uint>(b));
  return a>b?a:b;
}
#define AIR_MAX_VECTOR(N) \
  AIR_INLINE float##N max(float##N a,float##N b) { float##N r; for(uint i=0;i<N;++i) r[i]=max(a[i],b[i]); return r; } \
  AIR_INLINE float##N max(float##N a,float b) { return max(a,float##N(b)); }
AIR_MAX_VECTOR(2)
AIR_MAX_VECTOR(3)
AIR_MAX_VECTOR(4)
#undef AIR_MAX_VECTOR
template<class T> T floor(T) = delete;
AIR_INLINE float floor(float x) {
  uint bits=as_type<uint>(x), magnitude=bits & 0x7fffffffU;
  int exponent=int((bits >> 23) & 255u)-127;
  if (exponent < 0) return bits >> 31 ? (magnitude ? -1.0f : x) : 0.0f;
  if (exponent >= 23) return x; // Integral finite values, infinities and NaNs.
  uint unit=1u << uint(23-exponent), fraction=unit-1u;
  if (!(bits & fraction)) return x;
  if (bits >> 31) bits += unit;
  return as_type<float>(bits & ~fraction);
}
#define AIR_FLOOR_VECTOR(N) \
  AIR_INLINE float##N floor(float##N x) { float##N r; for(uint i=0;i<N;++i) r[i]=floor(x[i]); return r; }
AIR_FLOOR_VECTOR(2)
AIR_FLOOR_VECTOR(3)
AIR_FLOOR_VECTOR(4)
#undef AIR_FLOOR_VECTOR
#endif
// Saturation is an exact ordered clamp: NaN and either signed zero become +0.
// It does not opt into fast AIR intrinsics or flush subnormal inputs.
template<class T> T saturate(T) = delete;
AIR_INLINE float saturate(float x) { return !(x > 0.0f) ? 0.0f : x >= 1.0f ? 1.0f : x; }
