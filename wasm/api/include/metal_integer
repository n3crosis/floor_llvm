// Authored integer helpers and exact AIR integer intrinsics; no Apple SDK text.
#ifndef FLOOR_AIR_METAL_INTEGER
#define FLOOR_AIR_METAL_INTEGER
namespace metal {
namespace __integer_detail {
int absolute_signed(int) __asm__("air.abs.s.i32");
uint count_leading(uint,bool) __asm__("air.clz.i32");
uint population(uint) __asm__("air.popcount.i32");
uint reverse(uint) __asm__("air.reverse_bits.i32");
}
// Preserve the target intrinsic's signed edge behavior, including INT_MIN.
// Do not negate a signed integer or convert it to floating point.
inline __attribute__((always_inline)) int abs(int x) { return __integer_detail::absolute_signed(x); }
inline __attribute__((always_inline)) uint clz(uint x) { return __integer_detail::count_leading(x,false); }
inline __attribute__((always_inline)) int clz(int x) { return int(clz(uint(x))); }
inline __attribute__((always_inline)) uint popcount(uint x) { return __integer_detail::population(x); }
inline __attribute__((always_inline)) int popcount(int x) { return int(popcount(uint(x))); }
// This subset reverses exactly 32 bits; reject other widths, never promote them.
template<class T> T reverse_bits(T) = delete;
inline __attribute__((always_inline)) uint reverse_bits(uint x) { return __integer_detail::reverse(x); }
// Keep every bit, including the sign bit, without signed numeric conversion.
inline __attribute__((always_inline)) int reverse_bits(int x) { return as_type<int>(reverse_bits(as_type<uint>(x))); }
inline __attribute__((always_inline)) uint ctz(uint x) { return popcount((x & (0u-x))-1u); }
inline __attribute__((always_inline)) int ctz(int x) { return int(ctz(uint(x))); }

inline __attribute__((always_inline)) uint extract_bits(uint x, uint offset, uint count) {
  if (count == 0) return 0;
  if (count == 32) return x;
  return (x >> offset) & ((1u << count) - 1u);
}
inline __attribute__((always_inline)) int extract_bits(int x, uint offset, uint count) {
  if (count == 0) return 0;
  if (count == 32) return x;
  uint field = uint(x) >> offset;
  uint shift = 32u - count;
  return as_type<int>(field << shift) >> shift;
}
inline __attribute__((always_inline)) uint insert_bits(uint base, uint value, uint offset, uint count) {
  if (count == 0) return base;
  if (count == 32) return value;
  uint mask = ((1u << count) - 1u) << offset;
  return (base & ~mask) | ((value << offset) & mask);
}
inline __attribute__((always_inline)) int insert_bits(int base, int value, uint offset, uint count) {
  return as_type<int>(insert_bits(uint(base), uint(value), offset, count));
}
// BEGIN 32-bit vector subset
// MSL 4.1 (2026-06-04), section 6.4, Table 6.2, pp. 202-204:
// integer functions preserve T, including signedness and vector lane count.
// Only int/uint and their 2/3/4-lane vectors are implemented here. Reject
// other operand types instead of silently promoting narrow scalar operands.
template<class T> T clz(T) = delete;
template<class T> T ctz(T) = delete;
template<class T> T popcount(T) = delete;
template<class T> T extract_bits(T, uint, uint) = delete;
template<class A, class B> A insert_bits(A, B, uint, uint) = delete;

#define AIR_INTEGER_VECTOR(T,N) \
  inline __attribute__((always_inline)) T##N clz(T##N x) { T##N r; for(uint i=0;i<N;++i) r[i]=clz(x[i]); return r; } \
  inline __attribute__((always_inline)) T##N ctz(T##N x) { T##N r; for(uint i=0;i<N;++i) r[i]=ctz(x[i]); return r; } \
  inline __attribute__((always_inline)) T##N popcount(T##N x) { T##N r; for(uint i=0;i<N;++i) r[i]=popcount(x[i]); return r; } \
  inline __attribute__((always_inline)) T##N reverse_bits(T##N x) { T##N r; for(uint i=0;i<N;++i) r[i]=reverse_bits(x[i]); return r; } \
  inline __attribute__((always_inline)) T##N extract_bits(T##N x,uint offset,uint count) { T##N r; for(uint i=0;i<N;++i) r[i]=extract_bits(x[i],offset,count); return r; } \
  inline __attribute__((always_inline)) T##N insert_bits(T##N base,T##N value,uint offset,uint count) { T##N r; for(uint i=0;i<N;++i) r[i]=insert_bits(base[i],value[i],offset,count); return r; }
AIR_INTEGER_VECTOR(int,2)
AIR_INTEGER_VECTOR(int,3)
AIR_INTEGER_VECTOR(int,4)
AIR_INTEGER_VECTOR(uint,2)
AIR_INTEGER_VECTOR(uint,3)
AIR_INTEGER_VECTOR(uint,4)
#undef AIR_INTEGER_VECTOR
// END 32-bit vector subset
}
#endif
