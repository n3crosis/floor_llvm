// MSL 3 resource handles need explicit implicit-object address-space overloads.
// Authored depth views for real SPIRV-Cross texture-handle casts.
#ifndef FLOOR_AIR_METAL_DEPTH
#define FLOOR_AIR_METAL_DEPTH
#include <metal_texture>
namespace metal {
namespace __texture_detail {
extern "C" float4 __compare_depth2d_array(image2d_array_depth_t, sampler_t, ulong, float2, uint, uint, int2, int, float, bool, bool, bool, float2, float2, bool, uint, float, bool) __asm__("floor.opaque.read_image.depth2d_array.float.f2");
