}
template<> struct depth2d_array<float, access::sample> {
 image2d_array_depth_t __handle [[floor::image_data_type(float), floor::image_flags(0x400UL)]];
 __attribute__((always_inline)) float sample_compare(sampler state, float2 uv, uint layer, float reference) const thread {
  return __texture_detail::__compare_depth2d_array(__handle,state,0x1123400UL,uv,layer,0,int2(0),0,0.f,false,true,false,float2(0.f),float2(0.f),false,0,reference,true).x;
 }
 __attribute__((always_inline)) float sample_compare(sampler state, float2 uv, uint layer, float reference) const device {
  return __texture_detail::__compare_depth2d_array(__handle,state,0x1123400UL,uv,layer,0,int2(0),0,0.f,false,true,false,float2(0.f),float2(0.f),false,0,reference,true).x;
 }
 __attribute__((always_inline)) float sample_compare(sampler state, float2 uv, uint layer, float reference) const constant {
  return __texture_detail::__compare_depth2d_array(__handle,state,0x1123400UL,uv,layer,0,int2(0),0,0.f,false,true,false,float2(0.f),float2(0.f),false,0,reference,true).x;
 }
 __attribute__((always_inline)) float sample_compare(sampler state, float2 uv, uint layer, float reference) const threadgroup {
  return __texture_detail::__compare_depth2d_array(__handle,state,0x1123400UL,uv,layer,0,int2(0),0,0.f,false,true,false,float2(0.f),float2(0.f),false,0,reference,true).x;
 }
};
